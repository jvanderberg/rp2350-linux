diff --git a/riscv32-gen.c b/riscv32-gen.c
new file mode 100644
index 00000000..ebe1eb46
--- /dev/null
+++ b/riscv32-gen.c
@@ -0,0 +1,1138 @@
+/*
+ *  RISC-V rv32ima code generator for TCC
+ *
+ *  ilp32 soft-float ABI: there is no FPU and no compressed instructions.
+ *  float values live in one integer register, double and long long values
+ *  in a pair of them (long double too: see gen_ldouble_load), and
+ *  every floating point operation is a call to a libgcc helper
+ *  (__adddf3 & co).  Long long arithmetic is split into 32-bit operations
+ *  by the generic code in tccgen.c.
+ *
+ *  Based on riscv64-gen.c.
+ */
+
+#ifdef TARGET_DEFS_ONLY
+
+// Number of registers available to allocator:
+#define NB_REGS 10 // x10-x17 aka a0-a7, ra, sp
+#define CONFIG_TCC_ASM
+
+#define TREG_R(x) (x) // x = 0..7
+
+// Register classes sorted from more general to more precise:
+#define RC_INT (1 << 0)
+#define RC_FLOAT (1 << 1) // no register has it: fp values use RC_INT
+#define RC_R(x) (1 << (2 + (x))) // x = 0..7
+
+#define RC_IRET (RC_R(0)) // int return register class
+#define RC_IRE2 (RC_R(1)) // int 2nd return register class
+#define RC_FRET RC_IRET   // soft-float: fp values come back in a0(/a1)
+
+#define REG_IRET (TREG_R(0)) // int return register number
+#define REG_IRE2 (TREG_R(1)) // int 2nd return register number
+#define REG_FRET REG_IRET
+
+#define PTR_SIZE 4
+
+/* long double is the ABI's 128-bit quad in memory and at calls (by
+   reference), but has double precision: in registers it is a double */
+#define LDOUBLE_SIZE 16
+#define LDOUBLE_ALIGN 16
+
+#define MAX_ALIGN 16
+
+#define CHAR_IS_UNSIGNED
+
+/* define if return values need to be extended explicitely
+   at caller side (for interfacing with non-TCC compilers) */
+#define PROMOTE_RET
+
+#else
+#define USING_GLOBALS
+#include "tcc.h"
+#include <assert.h>
+
+#define UPPER(x)	(((unsigned)(x) + 0x800u) & 0xfffff000)
+#define LOW_OVERFLOW(x)	UPPER(x)
+#define SIGN11(x)	((((x) & 0xfff) ^ 0x800) - 0x800)
+
+ST_DATA const char * const target_machine_defs =
+    "__riscv\0"
+    "__riscv_xlen 32\0"
+    "__riscv_div\0"
+    "__riscv_mul\0"
+    "__riscv_muldiv\0"
+    "__riscv_atomic\0"
+    "__riscv_float_abi_soft\0"
+    ;
+
+#define XLEN 4
+
+#define TREG_RA 8
+#define TREG_SP 9
+
+ST_DATA const int reg_classes[NB_REGS] = {
+  RC_INT | RC_R(0),
+  RC_INT | RC_R(1),
+  RC_INT | RC_R(2),
+  RC_INT | RC_R(3),
+  RC_INT | RC_R(4),
+  RC_INT | RC_R(5),
+  RC_INT | RC_R(6),
+  RC_INT | RC_R(7),
+  0, // ra
+  0, // sp
+};
+
+static int ireg(int r)
+{
+    if (r == TREG_RA)
+      return 1; // ra
+    if (r == TREG_SP)
+      return 2; // sp
+    assert(r >= 0 && r < 8);
+    return r + 10;  // tccrX --> aX == x(10+X)
+}
+
+/* two-word scalars: long long and (long) double */
+static int is_two_words(int t)
+{
+    t &= VT_BTYPE;
+    return t == VT_LLONG || t == VT_DOUBLE || t == VT_LDOUBLE;
+}
+
+ST_FUNC void o(unsigned int c)
+{
+    int ind1 = ind + 4;
+    if (nocode_wanted)
+        return;
+    if (ind1 > cur_text_section->data_allocated)
+        section_realloc(cur_text_section, ind1);
+    write32le(cur_text_section->data + ind, c);
+    ind = ind1;
+}
+
+static void EIu(uint32_t opcode, uint32_t func3,
+               uint32_t rd, uint32_t rs1, uint32_t imm)
+{
+    o(opcode | (func3 << 12) | (rd << 7) | (rs1 << 15) | (imm << 20));
+}
+
+static void ER(uint32_t opcode, uint32_t func3,
+               uint32_t rd, uint32_t rs1, uint32_t rs2, uint32_t func7)
+{
+    o(opcode | func3 << 12 | rd << 7 | rs1 << 15 | rs2 << 20 | func7 << 25);
+}
+
+static void EI(uint32_t opcode, uint32_t func3,
+               uint32_t rd, uint32_t rs1, uint32_t imm)
+{
+    assert(! LOW_OVERFLOW(imm));
+    EIu(opcode, func3, rd, rs1, imm);
+}
+
+static void ES(uint32_t opcode, uint32_t func3,
+               uint32_t rs1, uint32_t rs2, uint32_t imm)
+{
+    assert(! LOW_OVERFLOW(imm));
+    o(opcode | (func3 << 12) | ((imm & 0x1f) << 7) | (rs1 << 15)
+      | (rs2 << 20) | ((imm >> 5) << 25));
+}
+
+/* rd = sp/s0 + imm, for any 32-bit imm (uses t0 when it is large) */
+static void addi_large(int rd, int rs, int imm)
+{
+    if (LOW_OVERFLOW(imm)) {
+        o(0x37 | (5 << 7) | UPPER(imm)); // lui t0, upper(imm)
+        EI(0x13, 0, 5, 5, SIGN11(imm));  // addi t0, t0, lo(imm)
+        ER(0x33, 0, rd, rs, 5, 0);       // add rd, rs, t0
+    } else
+        EI(0x13, 0, rd, rs, imm);        // addi rd, rs, imm
+}
+
+// Patch all branches in list pointed to by t to branch to a:
+ST_FUNC void gsym_addr(int t_, int a_)
+{
+    uint32_t t = t_;
+    uint32_t a = a_;
+    while (t) {
+        unsigned char *ptr = cur_text_section->data + t;
+        uint32_t next = read32le(ptr);
+        uint32_t r = a - t, imm;
+        if ((r + (1 << 21)) & ~((1U << 22) - 2))
+          tcc_error("out-of-range branch chain");
+        imm = (((r >> 12) &  0xff) << 12)
+            | (((r >> 11) &     1) << 20)
+            | (((r >>  1) & 0x3ff) << 21)
+            | (((r >> 20) &     1) << 31);
+        write32le(ptr, r == 4 ? 0x33 : 0x6f | imm); // nop || j imm
+        t = next;
+    }
+}
+
+/* Make the base register for an access to *sv (a symbol or a local);
+   returns it and the 12-bit offset left for the access in *new_fc.
+   The instruction emitted right after this one must be the access
+   (it carries the %pcrel_lo relocation). */
+static int load_symofs(int r, SValue *sv, int forstore, int *new_fc)
+{
+    int rr, doload = 0, large_addend = 0;
+    int fc = sv->c.i, v = sv->r & VT_VALMASK;
+    if (sv->r & VT_SYM) {
+        Sym label = {0};
+        assert(v == VT_CONST);
+        if (sv->sym->type.t & VT_TLS) {
+            /* TLS Local Exec model: lui + addi + add tp */
+            rr = r >= 0 ? ireg(r) : 5;
+            greloca(cur_text_section, sv->sym, ind,
+                    R_RISCV_TPREL_HI20, sv->c.i);
+            o(0x37 | (rr << 7));  // lui RR, 0 %tprel_hi(sym)
+            greloca(cur_text_section, sv->sym, ind,
+                    R_RISCV_TPREL_LO12_I, sv->c.i);
+            EI(0x13, 0, rr, rr, 0); // addi RR, RR, 0 %tprel_lo(sym)
+            ER(0x33, 0, rr, rr, 4, 0); // add RR, RR, tp
+            *new_fc = 0;
+            return rr;
+        }
+        if (sv->sym->type.t & VT_STATIC) { // XXX do this per linker relax
+            greloca(cur_text_section, sv->sym, ind,
+                    R_RISCV_PCREL_HI20, sv->c.i);
+            *new_fc = 0;
+        } else {
+            if (LOW_OVERFLOW(fc))
+              large_addend = 1;
+            greloca(cur_text_section, sv->sym, ind,
+                    R_RISCV_GOT_HI20, 0);
+            doload = 1;
+        }
+        label.type.t = VT_VOID | VT_STATIC;
+        if (!nocode_wanted)
+            put_extern_sym(&label, cur_text_section, ind, 0);
+        rr = r >= 0 ? ireg(r) : 5;
+        o(0x17 | (rr << 7));   // auipc RR, 0 %pcrel_hi(sym)+addend
+        greloca(cur_text_section, &label, ind,
+                doload || !forstore
+                  ? R_RISCV_PCREL_LO12_I : R_RISCV_PCREL_LO12_S, 0);
+        if (doload) {
+            EI(0x03, 2, rr, rr, 0); // lw RR, 0(RR)
+            if (large_addend) {
+                o(0x37 | (6 << 7) | UPPER(fc)); //lui t1, high(fc)
+                ER(0x33, 0, rr, rr, 6, 0); // add RR, RR, t1
+                *new_fc = SIGN11(fc);
+            }
+        }
+    } else if (v == VT_LOCAL || v == VT_LLOCAL) {
+        rr = 8; // s0
+        if (LOW_OVERFLOW(fc)) {
+            rr = r >= 0 ? ireg(r) : 5; // t0
+            o(0x37 | (rr << 7) | UPPER(fc)); //lui RR, upper(fc)
+            ER(0x33, 0, rr, rr, 8, 0); // add RR, RR, s0
+            *new_fc = SIGN11(fc);
+        }
+    } else
+      tcc_error("uhh");
+    return rr;
+}
+
+ST_FUNC void load(int r, SValue *sv)
+{
+    int fr = sv->r;
+    int v = fr & VT_VALMASK;
+    int rr = ireg(r);
+    int fc = sv->c.i;
+    int bt = sv->type.t & VT_BTYPE;
+    int align, size;
+    if (fr & VT_LVAL) {
+        int func3, br;
+        size = type_size(&sv->type, &align);
+        /* pointers are one word; two-word values are loaded one
+           word at a time by the generic code */
+        if (bt == VT_PTR || bt == VT_FUNC || size > 4)
+          size = 4;
+        func3 = size == 1 ? 0 : size == 2 ? 1 : 2;
+        if (size < 4 && (sv->type.t & VT_UNSIGNED))
+          func3 |= 4;
+        if (v == VT_LOCAL || (fr & VT_SYM)) {
+            br = load_symofs(r, sv, 0, &fc);
+        } else if (v < VT_CONST) {
+            br = ireg(v);
+            fc = 0; // XXX store ofs in LVAL(reg)
+        } else if (v == VT_LLOCAL) {
+            br = load_symofs(r, sv, 0, &fc);
+            EI(0x03, 2, rr, br, fc); // lw RR, fc(BR)
+            br = rr;
+            fc = 0;
+        } else if (v == VT_CONST) {
+            o(0x37 | (rr << 7) | UPPER(fc)); //lui RR, upper(fc)
+            fc = SIGN11(fc);
+            br = rr;
+        } else {
+            tcc_error("unimp: load(non-local lval)");
+        }
+        EI(0x03, func3, rr, br, fc); // l[bh][u]/lw RR, fc(BR)
+    } else if (v == VT_CONST) {
+        int rb = 0;
+        if (is_float(sv->type.t) && bt == VT_FLOAT) {
+            /* float constant: its bit pattern */
+            union { float f; uint32_t u; } x;
+            x.f = sv->c.f;
+            fc = x.u;
+        }
+        if (fr & VT_SYM) {
+            rb = load_symofs(r, sv, 0, &fc);
+            EI(0x13, 0, rr, rb, fc); // addi RR, RB, lo(fc) (%pcrel_lo)
+            return;
+        }
+        if (LOW_OVERFLOW(fc)) {
+            o(0x37 | (rr << 7) | UPPER(fc)), rb = rr; //lui RR, upper(fc)
+            if (SIGN11(fc))
+              EI(0x13, 0, rr, rb, SIGN11(fc)); // addi RR, RR, lo(fc)
+        } else
+            EI(0x13, 0, rr, 0, fc); // addi RR, x0, fc == li RR, fc
+    } else if (v == VT_LOCAL) {
+        int br = load_symofs(r, sv, 0, &fc);
+        EI(0x13, 0, rr, br, fc); // addi R, s0, FC
+    } else if (v < VT_CONST) { /* reg-reg */
+        //assert(!fc); XXX support offseted regs
+        if (rr != ireg(v))
+          EI(0x13, 0, rr, ireg(v), 0); // addi RR, V, 0 == mv RR, V
+    } else if (v == VT_CMP) {
+        int op = vtop->cmp_op;
+        int a = vtop->cmp_r & 0xff;
+        int b = (vtop->cmp_r >> 8) & 0xff;
+        int inv = 0;
+        switch (op) {
+            case TOK_ULT:
+            case TOK_UGE:
+            case TOK_ULE:
+            case TOK_UGT:
+            case TOK_LT:
+            case TOK_GE:
+            case TOK_LE:
+            case TOK_GT:
+                if (op & 1) { // remove [U]GE,GT
+                    inv = 1;
+                    op--;
+                }
+                if ((op & 7) == 6) { // [U]LE
+                    int t = a; a = b; b = t;
+                    inv ^= 1;
+                }
+                ER(0x33, (op > TOK_UGT) ? 2 : 3, rr, a, b, 0); // slt[u] d, a, b
+                if (inv)
+                  EI(0x13, 4, rr, rr, 1); // xori d, d, 1
+                break;
+            case TOK_NE:
+            case TOK_EQ:
+                if (rr != a || b)
+                  ER(0x33, 0, rr, a, b, 0x20); // sub d, a, b
+                if (op == TOK_NE)
+                  ER(0x33, 3, rr, 0, rr, 0); // sltu d, x0, d == snez d,d
+                else
+                  EI(0x13, 3, rr, rr, 1); // sltiu d, d, 1 == seqz d,d
+                break;
+        }
+    } else if ((v & ~1) == VT_JMP) {
+        int t = v & 1;
+        EI(0x13, 0, rr, 0, t);      // addi RR, x0, t
+        gjmp_addr(ind + 8);
+        gsym(fc);
+        EI(0x13, 0, rr, 0, t ^ 1);  // addi RR, x0, !t
+    } else
+      tcc_error("unimp: load(non-const)");
+}
+
+ST_FUNC void store(int r, SValue *sv)
+{
+    int fr = sv->r & VT_VALMASK;
+    int rr = ireg(r), ptrreg;
+    int fc = sv->c.i;
+    int bt = sv->type.t & VT_BTYPE;
+    int align, size = type_size(&sv->type, &align);
+    if (bt == VT_STRUCT)
+      tcc_error("unimp: store(struct)");
+    /* two-word values are stored one word at a time by the generic code */
+    if (bt == VT_PTR || bt == VT_FUNC || size > 4)
+      size = 4;
+    assert(sv->r & VT_LVAL);
+    if (fr == VT_LOCAL || (sv->r & VT_SYM)) {
+        ptrreg = load_symofs(-1, sv, 1, &fc);
+    } else if (fr < VT_CONST) {
+        ptrreg = ireg(fr);
+        fc = 0; // XXX support offsets regs
+    } else if (fr == VT_CONST) {
+        ptrreg = 5; // t0
+        o(0x37 | (ptrreg << 7) | UPPER(fc)); //lui t0, upper(fc)
+        fc = SIGN11(fc);
+    } else
+      tcc_error("implement me: %s(!local)", __FUNCTION__);
+    ES(0x23, size == 1 ? 0 : size == 2 ? 1 : 2, // s[bhw]
+       ptrreg, rr, fc);                         // RR, fc(base)
+}
+
+static void gcall_or_jmp(int docall)
+{
+    int tr = docall ? 1 : 5; // ra or t0
+    if ((vtop->r & (VT_VALMASK | VT_LVAL)) == VT_CONST &&
+        ((vtop->r & VT_SYM) && vtop->c.i == (int)vtop->c.i)) {
+        /* constant symbolic case -> simple relocation */
+        greloca(cur_text_section, vtop->sym, ind,
+                R_RISCV_CALL_PLT, (int)vtop->c.i);
+        o(0x17 | (tr << 7));   // auipc TR, 0 %call(func)
+        EI(0x67, 0, tr, tr, 0);// jalr  TR, r(TR)
+    } else if (vtop->r < VT_CONST) {
+        int r = ireg(vtop->r);
+        EI(0x67, 0, tr, r, 0);      // jalr TR, 0(R)
+    } else {
+        int r = TREG_RA;
+        load(r, vtop);
+        r = ireg(r);
+        EI(0x67, 0, tr, r, 0);      // jalr TR, 0(R)
+    }
+}
+
+/* type to load the word at 'ofs' of a small struct of 'size' bytes */
+static int struct_word_type(int size, int ofs)
+{
+    size -= ofs;
+    return size == 1 ? VT_BYTE | VT_UNSIGNED
+         : size == 2 ? VT_SHORT | VT_UNSIGNED
+         : VT_INT;
+}
+
+/* Arguments, ilp32 integer calling convention:
+   - scalars and structs of up to 2*XLEN bytes go in one or two of a0-a7;
+     a two-word value that finds only a7 free has its high word on the
+     stack, and variadic 8-byte aligned ones start at an even register;
+   - larger structs are copied and passed by reference;
+   - the rest goes on the stack, each aligned to max(XLEN, alignment).
+   info[i] bits: 0-3 register, 4 high word on stack, 5 on stack,
+   6 by reference (bits 7.. temp offset), 7-11 second register + 1. */
+ST_FUNC void gfunc_call(int nb_args)
+{
+    int i, align, size, areg;
+    int *info = tcc_malloc((nb_args + 1) * sizeof (int));
+    int stack_adj = 0, tempspace = 0, stack_add, ofs, splitofs = 0;
+    int old = (vtop[-nb_args].type.ref->f.func_type == FUNC_OLD);
+    SValue *sv;
+    Sym *sa;
+
+    areg = 0;
+    sa = vtop[-nb_args].type.ref->next;
+    for (i = 0; i < nb_args; i++) {
+        int nregs, byref = 0, tempofs;
+        sv = &vtop[1 + i - nb_args];
+        sv->type.t &= ~VT_ARRAY; // XXX this should be done in tccgen.c
+        size = type_size(&sv->type, &align);
+        if (size > 2 * XLEN) {
+            if (align < XLEN)
+              align = XLEN;
+            tempspace = (tempspace + align - 1) & -align;
+            tempofs = tempspace;
+            tempspace += size;
+            size = align = XLEN;
+            byref = 64 | (tempofs << 7);
+        }
+        nregs = (size + XLEN - 1) / XLEN;
+        if (!old && !sa && align == 2*XLEN && size == 2*XLEN)
+          areg = (areg + 1) & ~1;
+        if (size == 0)
+            info[i] = 0;
+        else if (areg >= 8) {
+            info[i] = 32;
+            if (align < XLEN)
+              align = XLEN;
+            stack_adj = (stack_adj + align - 1) & -align;
+            stack_adj += (size + XLEN - 1) & -XLEN;
+        } else {
+            info[i] = areg++;
+            if (nregs == 2) {
+                if (areg < 8)
+                  info[i] |= (1 + areg++) << 7;
+                else {
+                    info[i] |= 16;
+                    stack_adj += XLEN;
+                }
+            }
+        }
+        info[i] |= byref;
+        if (sa)
+          sa = sa->next;
+    }
+    stack_adj = (stack_adj + 15) & -16;
+    tempspace = (tempspace + 15) & -16;
+    stack_add = stack_adj + tempspace;
+
+    if (stack_add) {
+        addi_large(2, 2, -stack_add); // sp -= stack_add
+        for (i = ofs = 0; i < nb_args; i++) {
+            if (info[i] & (64 | 32)) {
+                vrotb(nb_args - i);
+                size = type_size(&vtop->type, &align);
+                if (info[i] & 64) {
+                    vset(&char_pointer_type, TREG_SP, 0);
+                    vpushi(stack_adj + (info[i] >> 7));
+                    gen_op('+');
+                    vpushv(vtop); // this replaces the old argument
+                    vrott(3);
+                    indir();
+                    vtop->type = vtop[-1].type;
+                    vswap();
+                    vstore();
+                    vpop();
+                    size = align = XLEN;
+                }
+                if (info[i] & 32) {
+                    if (align < XLEN)
+                      align = XLEN;
+                    /* Once we support offseted regs we can do this:
+                       vset(&vtop->type, TREG_SP | VT_LVAL, ofs);
+                       to construct the lvalue for the outgoing stack slot,
+                       until then we have to jump through hoops.  */
+                    vset(&char_pointer_type, TREG_SP, 0);
+                    ofs = (ofs + align - 1) & -align;
+                    vpushi(ofs);
+                    gen_op('+');
+                    indir();
+                    vtop->type = vtop[-1].type;
+                    vswap();
+                    vstore();
+                    vtop->r = vtop->r2 = VT_CONST; // this arg is done
+                    ofs += (size + XLEN - 1) & -XLEN;
+                }
+                vrott(nb_args - i);
+            } else if (info[i] & 16) {
+                assert(!splitofs);
+                splitofs = ofs;
+                ofs += XLEN;
+            }
+        }
+    }
+    for (i = 0; i < nb_args; i++) {
+        int ii = info[nb_args - 1 - i], r = ii, r2 = r;
+        if (!(r & 32)) {
+            CType origtype;
+            int loadt, pair;
+            r &= 15;
+            r2 = r2 & 64 ? 0 : (r2 >> 7) & 31;
+            vrotb(i+1);
+            origtype = vtop->type;
+            size = type_size(&vtop->type, &align);
+            if (size == 0)
+                goto done;
+            loadt = vtop->type.t & (VT_BTYPE | VT_UNSIGNED);
+            pair = is_two_words(loadt);
+            if ((loadt & VT_BTYPE) == VT_STRUCT)
+                loadt = struct_word_type(size, 0);
+            if (ii & 16) {
+                assert(!r2);
+                r2 = 1 + TREG_RA;
+            }
+            if (r2 && !pair) {
+                test_lvalue();
+                vpushv(vtop);
+            }
+            vtop->type.t = loadt;
+            gv(RC_R(r));
+            vtop->type = origtype;
+
+            if (r2 && !pair) {
+                /* second word of a struct */
+                r2--;
+                vswap();
+                gaddrof();
+                vtop->type = char_pointer_type;
+                vpushi(XLEN);
+                gen_op('+');
+                indir();
+                vtop->type.t = struct_word_type(size, XLEN);
+                save_reg_upstack(r2, 1);
+                load(r2, vtop);
+                vtop--;
+                vtop->r2 = r2;
+            } else if (r2 && !(ii & 16) && vtop->r2 != r2 - 1) {
+                /* XXX we'd like to have 'gv' move directly into
+                   the right class instead of us fixing it up.  */
+                r2--;
+                save_reg_upstack(r2, 1);
+                EI(0x13, 0, ireg(r2), ireg(vtop->r2), 0); // mv Ra+1, RR2
+                vtop->r2 = r2;
+            }
+            if (ii & 16) {
+                ES(0x23, 2, 2, ireg(vtop->r2), splitofs); // sw RR2, ofs(sp)
+                vtop->r2 = VT_CONST;
+            }
+done:
+            vrott(i+1);
+        }
+    }
+    vrotb(nb_args + 1);
+    save_regs(nb_args + 1);
+    gcall_or_jmp(1);
+    vtop -= nb_args + 1;
+    if (stack_add)
+        addi_large(2, 2, stack_add); // sp += stack_add
+    tcc_free(info);
+}
+
+static int func_sub_sp_offset, num_va_regs, func_va_list_ofs;
+
+/* Frame: s0 is the stack pointer at entry (minus the varargs register
+   save area, which sits right below the stack arguments), ra is at
+   s0-4, the caller's s0 at s0-8, locals below. */
+ST_FUNC void gfunc_prolog(Sym *func_sym)
+{
+    CType *func_type = &func_sym->type;
+    int i, addr, align, size;
+    int param_addr = 0;
+    int areg;
+    Sym *sym;
+    CType *type;
+
+    sym = func_type->ref;
+    loc = -2 * XLEN; // for ra and s0
+    func_sub_sp_offset = ind;
+    ind += 5 * 4;
+
+    areg = 0;
+    addr = 0;
+    /* if the function returns by reference, then add an
+       implicit pointer parameter */
+    size = type_size(&func_vt, &align);
+    if (size > 2 * XLEN) {
+        loc -= XLEN;
+        func_vc = loc;
+        ES(0x23, 2, 8, 10 + areg++, loc); // sw a0, loc(s0)
+    }
+    /* define parameters */
+    while ((sym = sym->next) != NULL) {
+        int byref = 0;
+        int nregs;
+        type = &sym->type;
+        size = type_size(type, &align);
+        if (size > 2 * XLEN) {
+            type = &char_pointer_type;
+            size = align = byref = XLEN;
+        }
+        nregs = (size + XLEN - 1) / XLEN;
+        if (areg >= 8) {
+            if (align < XLEN)
+              align = XLEN;
+            addr = (addr + align - 1) & -align;
+            param_addr = addr;
+            addr += (size + XLEN - 1) & -XLEN;
+        } else {
+            loc -= nregs * XLEN;
+            if (align > XLEN)
+              loc &= -align;
+            param_addr = loc;
+            for (i = 0; i < nregs; i++) {
+                if (areg >= 8) {
+                    /* high word of a split two-word value */
+                    assert(i == 1 && nregs == 2);
+                    EI(0x03, 2, 5, 8, addr); // lw t0, addr(s0)
+                    addr += XLEN;
+                    ES(0x23, 2, 8, 5, loc + i*XLEN); // sw t0, loc(s0)
+                } else {
+                    ES(0x23, 2, 8, 10 + areg++, loc + i*XLEN); // sw aX, loc(s0)
+                }
+            }
+        }
+        gfunc_set_param(sym, param_addr, byref);
+    }
+    func_va_list_ofs = addr;
+    num_va_regs = 0;
+    if (func_var) {
+        for (; areg < 8; areg++) {
+            num_va_regs++;
+            ES(0x23, 2, 8, 10 + areg, -XLEN + num_va_regs * XLEN); // sw aX, loc(s0)
+        }
+    }
+}
+
+ST_FUNC int gfunc_sret(CType *vt, int variadic, CType *ret,
+                       int *ret_align, int *regsize)
+{
+    int align, size = type_size(vt, &align);
+    *ret_align = 1;
+    *regsize = XLEN;
+    if (size > 2 * XLEN)
+      return 0;
+    ret->t = VT_INT;
+    ret->ref = NULL;
+    return (size + XLEN - 1) / XLEN;
+}
+
+ST_FUNC void gfunc_epilog(void)
+{
+    int v, saved_ind, d, large_ofs_ind;
+    int va = num_va_regs * XLEN;
+
+    loc = (loc - va);
+    d = v = (-loc + 15) & -16;
+
+    EI(0x13, 0, 2, 8, va); // addi sp, s0, va
+    EI(0x03, 2, 1, 8, -XLEN); // lw ra, -4(s0)
+    EI(0x03, 2, 8, 8, -2*XLEN); // lw s0, -8(s0)
+    EI(0x67, 0, 0, 1, 0); // jalr x0, 0(x1), aka ret
+
+    large_ofs_ind = ind;
+    if (v >= (1 << 11)) {
+        /* first allocate room for ra, s0 and the varargs, then the rest */
+        d = (2*XLEN + va + 15) & -16;
+        EI(0x13, 0, 8, 2, d - va);      // addi s0, sp, d - va
+        o(0x37 | (5 << 7) | UPPER(v-d)); //lui t0, upper(v-d)
+        EI(0x13, 0, 5, 5, SIGN11(v-d)); // addi t0, t0, lo(v-d)
+        ER(0x33, 0, 2, 2, 5, 0x20); // sub sp, sp, t0
+        gjmp_addr(func_sub_sp_offset + 5*4);
+    }
+    saved_ind = ind;
+
+    ind = func_sub_sp_offset;
+    EI(0x13, 0, 2, 2, -d);     // addi sp, sp, -d
+    ES(0x23, 2, 2, 1, d - XLEN - va);  // sw ra, d-4-va(sp)
+    ES(0x23, 2, 2, 8, d - 2*XLEN - va); // sw s0, d-8-va(sp)
+    if (v < (1 << 11))
+      EI(0x13, 0, 8, 2, d - va);      // addi s0, sp, d - va
+    else
+      gjmp_addr(large_ofs_ind);
+    if ((ind - func_sub_sp_offset) != 5*4)
+      EI(0x13, 0, 0, 0, 0);      // addi x0, x0, 0 == nop
+    ind = saved_ind;
+}
+
+ST_FUNC void gen_va_start(void)
+{
+    vtop--;
+    vset(&char_pointer_type, VT_LOCAL, func_va_list_ofs);
+}
+
+ST_FUNC void gen_fill_nops(int bytes)
+{
+    if ((bytes & 3))
+      tcc_error("alignment of code section not multiple of 4");
+    while (bytes > 0) {
+        EI(0x13, 0, 0, 0, 0);      // addi x0, x0, 0 == nop
+        bytes -= 4;
+    }
+}
+
+// Generate forward branch to label:
+ST_FUNC int gjmp(int t)
+{
+    if (nocode_wanted)
+      return t;
+    o(t);
+    return ind - 4;
+}
+
+// Generate branch to known address:
+ST_FUNC void gjmp_addr(int a)
+{
+    uint32_t r = a - ind, imm;
+    if ((r + (1 << 21)) & ~((1U << 22) - 2)) {
+        o(0x17 | (5 << 7) | UPPER(r)); // auipc t0, up(r)
+        r = SIGN11(r);
+        EI(0x67, 0, 0, 5, r);      // jalr x0, r(t0)
+    } else {
+        imm = (((r >> 12) &  0xff) << 12)
+            | (((r >> 11) &     1) << 20)
+            | (((r >>  1) & 0x3ff) << 21)
+            | (((r >> 20) &     1) << 31);
+        o(0x6f | imm); // jal x0, imm ==  j imm
+    }
+}
+
+ST_FUNC int gjmp_cond(int op, int t)
+{
+    int tmp;
+    int a = vtop->cmp_r & 0xff;
+    int b = (vtop->cmp_r >> 8) & 0xff;
+    switch (op) {
+        case TOK_ULT: op = 6; break;
+        case TOK_UGE: op = 7; break;
+        case TOK_ULE: op = 7; tmp = a; a = b; b = tmp; break;
+        case TOK_UGT: op = 6; tmp = a; a = b; b = tmp; break;
+        case TOK_LT:  op = 4; break;
+        case TOK_GE:  op = 5; break;
+        case TOK_LE:  op = 5; tmp = a; a = b; b = tmp; break;
+        case TOK_GT:  op = 4; tmp = a; a = b; b = tmp; break;
+        case TOK_NE:  op = 1; break;
+        case TOK_EQ:  op = 0; break;
+    }
+    o(0x63 | (op ^ 1) << 12 | a << 15 | b << 20 | 8 << 7); // bOP a,b,+4
+    return gjmp(t);
+}
+
+ST_FUNC int gjmp_append(int n, int t)
+{
+    void *p;
+    /* insert jump list n into t */
+    if (n) {
+        uint32_t n1 = n, n2;
+        while ((n2 = read32le(p = cur_text_section->data + n1)))
+            n1 = n2;
+        write32le(p, t);
+        t = n;
+    }
+    return t;
+}
+
+/* The carry (or borrow) between the two halves of a long long add (sub)
+   lives in t2 from TOK_ADDC1 (SUBC1) to TOK_ADDC2 (SUBC2): no code in
+   between uses it. */
+#define REG_CARRY 7
+
+ST_FUNC void gen_opi(int op)
+{
+    int a, b, d;
+    int func3 = 0;
+    if ((vtop->r & (VT_VALMASK | VT_LVAL | VT_SYM)) == VT_CONST) {
+        int fc = vtop->c.i;
+        if (!LOW_OVERFLOW(fc)) {
+            vswap();
+            gv(RC_INT);
+            a = ireg(vtop[0].r);
+            --vtop;
+            d = get_reg(RC_INT);
+            ++vtop;
+            vswap();
+            switch (op) {
+                case '-':
+                    if (fc <= -(1 << 11))
+                      break;
+                    fc = -fc;
+                case '+':
+                    func3 = 0; // addi d, a, fc
+                do_cop:
+                    EI(0x13, func3, ireg(d), a, fc);
+                    --vtop;
+                    if (op >= TOK_ULT && op <= TOK_GT) {
+                      vset_VT_CMP(TOK_NE);
+                      vtop->cmp_r = ireg(d) | 0 << 8;
+                    } else
+                      vtop[0].r = d;
+                    return;
+                case TOK_LE:
+                    if (fc >= (1 << 11) - 1)
+                      break;
+                    ++fc;
+                case TOK_LT:  func3 = 2; goto do_cop; // slti d, a, fc
+                case TOK_ULE:
+                    if (fc >= (1 << 11) - 1 || fc == -1)
+                      break;
+                    ++fc;
+                case TOK_ULT: func3 = 3; goto do_cop; // sltiu d, a, fc
+                case '^':     func3 = 4; goto do_cop; // xori d, a, fc
+                case '|':     func3 = 6; goto do_cop; // ori  d, a, fc
+                case '&':     func3 = 7; goto do_cop; // andi d, a, fc
+                case TOK_SHL: func3 = 1; fc &= 31; goto do_cop; // slli d, a, fc
+                case TOK_SHR: func3 = 5; fc &= 31; goto do_cop; // srli d, a, fc
+                case TOK_SAR: func3 = 5; fc = 1024 | (fc & 31); goto do_cop;
+
+                case TOK_UGE: /* -> TOK_ULT */
+                case TOK_UGT: /* -> TOK_ULE */
+                case TOK_GE:  /* -> TOK_LT */
+                case TOK_GT:  /* -> TOK_LE */
+                    gen_opi(op - 1);
+                    vtop->cmp_op ^= 1;
+                    return;
+
+                case TOK_NE:
+                case TOK_EQ:
+                    if (fc)
+                      gen_opi('-'), a = ireg(vtop++->r);
+                    --vtop;
+                    vset_VT_CMP(op);
+                    vtop->cmp_r = a | 0 << 8;
+                    return;
+            }
+        }
+    }
+    gv2(RC_INT, RC_INT);
+    a = ireg(vtop[-1].r);
+    b = ireg(vtop[0].r);
+    if (op == TOK_UMULL) {
+        /* 32x32 -> 64: low word into a's register, high word into a new one */
+        int h = get_reg(RC_INT);
+        ER(0x33, 3, ireg(h), a, b, 1); // mulhu h, a, b
+        ER(0x33, 0, a, a, b, 1);       // mul a, a, b
+        vtop--;
+        vtop->r2 = h;
+        return;
+    }
+    vtop -= 2;
+    d = get_reg(RC_INT);
+    vtop++;
+    vtop[0].r = d;
+    d = ireg(d);
+    switch (op) {
+    default:
+        if (op >= TOK_ULT && op <= TOK_GT) {
+            vset_VT_CMP(op);
+            vtop->cmp_r = a | b << 8;
+            break;
+        }
+        tcc_error("implement me: %s(%s)", __FUNCTION__, get_tok_str(op, NULL));
+        break;
+
+    case '+':
+        ER(0x33, 0, d, a, b, 0); // add d, a, b
+        break;
+    case TOK_ADDC1:
+        ER(0x33, 0, d, a, b, 0); // add d, a, b
+        ER(0x33, 3, REG_CARRY, d, d == a ? b : a, 0); // sltu t2, d, (a|b)
+        break;
+    case TOK_ADDC2:
+        ER(0x33, 0, d, a, b, 0); // add d, a, b
+        ER(0x33, 0, d, d, REG_CARRY, 0); // add d, d, t2
+        break;
+    case '-':
+        ER(0x33, 0, d, a, b, 0x20); // sub d, a, b
+        break;
+    case TOK_SUBC1:
+        ER(0x33, 3, REG_CARRY, a, b, 0); // sltu t2, a, b
+        ER(0x33, 0, d, a, b, 0x20); // sub d, a, b
+        break;
+    case TOK_SUBC2:
+        ER(0x33, 0, d, a, b, 0x20); // sub d, a, b
+        ER(0x33, 0, d, d, REG_CARRY, 0x20); // sub d, d, t2
+        break;
+    case TOK_SAR:
+        ER(0x33, 5, d, a, b, 0x20); // sra d, a, b
+        break;
+    case TOK_SHR:
+        ER(0x33, 5, d, a, b, 0); // srl d, a, b
+        break;
+    case TOK_SHL:
+        ER(0x33, 1, d, a, b, 0); // sll d, a, b
+        break;
+    case '*':
+        ER(0x33, 0, d, a, b, 1); // mul d, a, b
+        break;
+    case '/':
+    case TOK_PDIV:
+        ER(0x33, 4, d, a, b, 1); // div d, a, b
+        break;
+    case '&':
+        ER(0x33, 7, d, a, b, 0); // and d, a, b
+        break;
+    case '^':
+        ER(0x33, 4, d, a, b, 0); // xor d, a, b
+        break;
+    case '|':
+        ER(0x33, 6, d, a, b, 0); // or d, a, b
+        break;
+    case '%':
+        ER(0x33, 6, d, a, b, 1); // rem d, a, b
+        break;
+    case TOK_UMOD:
+        ER(0x33, 7, d, a, b, 1); // remu d, a, b
+        break;
+    case TOK_UDIV:
+        ER(0x33, 5, d, a, b, 1); // divu d, a, b
+        break;
+    }
+}
+
+/* call the libgcc soft-float helper 'func' on the top 'nargs' values and
+   leave its result, of type 't', on the stack */
+static void gen_fp_call(int func, int nargs, int t)
+{
+    int i;
+    /* the double helpers serve long double too: pass its register form */
+    for (i = 0; i < nargs; i++) {
+        vrotb(nargs);
+        if ((vtop->type.t & VT_BTYPE) == VT_LDOUBLE) {
+            gv(RC_INT);
+            vtop->type.t = VT_DOUBLE;
+        }
+    }
+    vpush_helper_func(func);
+    vrott(nargs + 1);
+    gfunc_call(nargs);
+    vpushi(0);
+    vtop->type.t = t;
+    vtop->r = REG_IRET;
+    vtop->r2 = is_two_words(t) ? REG_IRE2 : VT_CONST;
+}
+
+ST_FUNC void gen_opf(int op)
+{
+    int t = vtop->type.t & (VT_BTYPE | VT_LONG);
+    int dbl = (t & VT_BTYPE) != VT_FLOAT;
+    int func;
+
+    if (op == TOK_NEG) {
+        /* flip the sign bit of the (high) word */
+        int r;
+        gv(RC_INT);
+        r = ireg(dbl ? vtop->r2 : vtop->r);
+        o(0x37 | (5 << 7) | 0x80000000); // lui t0, 0x80000
+        ER(0x33, 4, r, r, 5, 0); // xor r, r, t0
+        return;
+    }
+    switch (op) {
+    case '+': func = dbl ? TOK___adddf3 : TOK___addsf3; break;
+    case '-': func = dbl ? TOK___subdf3 : TOK___subsf3; break;
+    case '*': func = dbl ? TOK___muldf3 : TOK___mulsf3; break;
+    case '/': func = dbl ? TOK___divdf3 : TOK___divsf3; break;
+    /* a OP b is __OPdf2(a, b) OP 0, NaNs included */
+    case TOK_EQ: func = dbl ? TOK___eqdf2 : TOK___eqsf2; break;
+    case TOK_NE: func = dbl ? TOK___nedf2 : TOK___nesf2; break;
+    case TOK_LT: func = dbl ? TOK___ltdf2 : TOK___ltsf2; break;
+    case TOK_LE: func = dbl ? TOK___ledf2 : TOK___lesf2; break;
+    case TOK_GT: func = dbl ? TOK___gtdf2 : TOK___gtsf2; break;
+    case TOK_GE: func = dbl ? TOK___gedf2 : TOK___gesf2; break;
+    default:
+        tcc_error("implement me: %s(%s)", __FUNCTION__, get_tok_str(op, NULL));
+        return;
+    }
+    if (op >= TOK_ULT && op <= TOK_GT) {
+        gen_fp_call(func, 2, VT_INT);
+        vpushi(0);
+        gen_opi(op);
+    } else
+        gen_fp_call(func, 2, t);
+}
+
+ST_FUNC void gen_cvt_itof(int t)
+{
+    int st = vtop->type.t & (VT_BTYPE | VT_UNSIGNED);
+    int u = st & VT_UNSIGNED;
+    int l = (st & VT_BTYPE) == VT_LLONG;
+    int dbl = (t & VT_BTYPE) != VT_FLOAT;
+    int func = l ?
+      (u ? (dbl ? TOK___floatundidf : TOK___floatundisf)
+         : (dbl ? TOK___floatdidf : TOK___floatdisf)) :
+      (u ? (dbl ? TOK___floatunsidf : TOK___floatunsisf)
+         : (dbl ? TOK___floatsidf : TOK___floatsisf));
+    gen_fp_call(func, 1, t);
+}
+
+ST_FUNC void gen_cvt_ftoi(int t)
+{
+    int dbl = (vtop->type.t & VT_BTYPE) != VT_FLOAT;
+    int l = (t & VT_BTYPE) == VT_LLONG;
+    int u = t & VT_UNSIGNED;
+    int func = l ?
+      (u ? (dbl ? TOK___fixunsdfdi : TOK___fixunssfdi)
+         : (dbl ? TOK___fixdfdi : TOK___fixsfdi)) :
+      (u ? (dbl ? TOK___fixunsdfsi : TOK___fixunssfsi)
+         : (dbl ? TOK___fixdfsi : TOK___fixsfsi));
+    gen_fp_call(func, 1, t);
+}
+
+ST_FUNC void gen_cvt_ftof(int dt)
+{
+    int st = vtop->type.t & VT_BTYPE;
+    if (st == VT_LDOUBLE)
+      st = VT_DOUBLE;
+    if ((dt & VT_BTYPE) == VT_LDOUBLE)
+      dt = (dt & ~VT_BTYPE) | VT_DOUBLE;
+    if (st == (dt & VT_BTYPE)) {
+        /* double <-> long double: the same in registers */
+        gv(RC_INT);
+        vtop->type.t = dt;
+        return;
+    }
+    gen_fp_call(st == VT_FLOAT ? TOK___extendsfdf2 : TOK___truncdfsf2, 1, dt);
+}
+
+/* lvalue long double (a quad) on the stack -> its value in a0/a1 as a
+   double, through __trunctfdf2 (which takes the quad by reference) */
+ST_FUNC void gen_ldouble_load(void)
+{
+    gaddrof();
+    vtop->type = char_pointer_type;
+    vpush_helper_func(TOK___trunctfdf2);
+    vswap();
+    gfunc_call(1);
+    vpushi(0);
+    vtop->type.t = VT_LDOUBLE;
+    vtop->r = REG_IRET;
+    vtop->r2 = REG_IRE2;
+}
+
+/* vstore() of a long double: stack: lvalue, value -> value; the quad is
+   made by __extenddftf2, which returns it through a hidden pointer (a0) */
+ST_FUNC void gen_ldouble_store(void)
+{
+    gv(RC_INT);
+    vpushv(vtop - 1);
+    gaddrof();
+    vtop->type = char_pointer_type;
+    vpushv(vtop - 1);
+    vtop->type.t = VT_DOUBLE;
+    vpush_helper_func(TOK___extenddftf2);
+    vrott(3);
+    gfunc_call(2);
+    vswap();
+    vtop--;
+}
+
+/* increment tcov counter */
+ST_FUNC void gen_increment_tcov (SValue *sv)
+{
+    int r1, r2;
+    Sym label = {0};
+    label.type.t = VT_VOID | VT_STATIC;
+
+    vpushv(sv);
+    vtop->r = r1 = get_reg(RC_INT);
+    r2 = get_reg(RC_INT);
+    r1 = ireg(r1);
+    r2 = ireg(r2);
+    greloca(cur_text_section, sv->sym, ind, R_RISCV_PCREL_HI20, 0);
+    put_extern_sym(&label, cur_text_section, ind, 0);
+    o(0x17 | (r1 << 7)); // auipc RR, 0 %pcrel_hi(sym)
+    greloca(cur_text_section, &label, ind, R_RISCV_PCREL_LO12_I, 0);
+    EI(0x03, 2, r2, r1, 0); // lw r2, x[r1]
+    EI(0x13, 0, r2, r2, 1); // addi r2, r2, #1
+    greloca(cur_text_section, sv->sym, ind, R_RISCV_PCREL_HI20, 0);
+    label.c = 0; /* force new local ELF symbol */
+    put_extern_sym(&label, cur_text_section, ind, 0);
+    o(0x17 | (r1 << 7)); // auipc RR, 0 %pcrel_hi(sym)
+    greloca(cur_text_section, &label, ind, R_RISCV_PCREL_LO12_S, 0);
+    ES(0x23, 2, r1, r2, 0); // sw r2, [r1]
+    vpop();
+}
+
+ST_FUNC void ggoto(void)
+{
+    gcall_or_jmp(0);
+    vtop--;
+}
+
+ST_FUNC void gen_vla_sp_save(int addr)
+{
+    if (LOW_OVERFLOW(addr)) {
+        o(0x37 | (5 << 7) | UPPER(addr)); //lui t0,upper(addr)
+        ER(0x33, 0, 5, 5, 8, 0); // add t0, t0, s0
+        ES(0x23, 2, 5, 2, SIGN11(addr)); // sw sp, fc(t0)
+    }
+    else
+        ES(0x23, 2, 8, 2, addr); // sw sp, fc(s0)
+}
+
+ST_FUNC void gen_vla_sp_restore(int addr)
+{
+    if (LOW_OVERFLOW(addr)) {
+        o(0x37 | (5 << 7) | UPPER(addr)); //lui t0,upper(addr)
+        ER(0x33, 0, 5, 5, 8, 0); // add t0, t0, s0
+        EI(0x03, 2, 2, 5, SIGN11(addr)); // lw sp, fc(t0)
+    }
+    else
+        EI(0x03, 2, 2, 8, addr); // lw sp, fc(s0)
+}
+
+ST_FUNC void gen_vla_alloc(CType *type, int align)
+{
+    int rr = ireg(gv(RC_INT));
+    EI(0x13, 0, rr, rr, 15);   // addi RR, RR, 15
+    EI(0x13, 7, rr, rr, -16);  // andi, RR, RR, -16
+    ER(0x33, 0, 2, 2, rr, 0x20); // sub sp, sp, rr
+    vpop();
+}
+
+#endif
