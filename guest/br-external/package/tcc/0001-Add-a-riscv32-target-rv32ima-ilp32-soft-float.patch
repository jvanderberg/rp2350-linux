diff --git a/lib/atomic-rv32-8.c b/lib/atomic-rv32-8.c
new file mode 100644
index 00000000..48ca304a
--- /dev/null
+++ b/lib/atomic-rv32-8.c
@@ -0,0 +1,53 @@
+/* 8 byte __atomic_* helpers for riscv32, which has no 64-bit LR/SC:
+   they take a spinlock, like GCC's libatomic does. */
+#define bool _Bool
+typedef unsigned long long uint64_t;
+
+bool __atomic_compare_exchange_4(volatile void *p, void *expected,
+                                 unsigned desired, bool weak, int s, int f);
+void __atomic_store_4(volatile void *p, unsigned v, int order);
+
+static unsigned lock8;
+
+static void lock(void)
+{
+    unsigned zero;
+    do
+        zero = 0;
+    while (!__atomic_compare_exchange_4(&lock8, &zero, 1, 0, 5, 5));
+}
+
+static void unlock(void)
+{
+    __atomic_store_4(&lock8, 0, 5);
+}
+
+uint64_t __atomic_load_8(volatile void *p, int order)
+{
+    uint64_t v;
+    lock();
+    v = *(volatile uint64_t *)p;
+    unlock();
+    return v;
+}
+
+void __atomic_store_8(volatile void *p, uint64_t v, int order)
+{
+    lock();
+    *(volatile uint64_t *)p = v;
+    unlock();
+}
+
+bool __atomic_compare_exchange_8(volatile void *p, void *expected,
+                                 uint64_t desired, bool weak, int s, int f)
+{
+    bool ok;
+    lock();
+    ok = *(volatile uint64_t *)p == *(uint64_t *)expected;
+    if (ok)
+        *(volatile uint64_t *)p = desired;
+    else
+        *(uint64_t *)expected = *(volatile uint64_t *)p;
+    unlock();
+    return ok;
+}
diff --git a/lib/atomic-rv32.S b/lib/atomic-rv32.S
new file mode 100644
index 00000000..c5d915d9
--- /dev/null
+++ b/lib/atomic-rv32.S
@@ -0,0 +1,151 @@
+/* __atomic_* helpers for riscv32 (rv32ima: no compressed instructions,
+   which atomic.S's riscv code has, and no 64-bit LR/SC).
+   1, 2 and 4 byte objects; the 8 byte ones are in atomic-rv32-8.c.
+
+   bool __atomic_compare_exchange_N(void *p, T *expected, T desired,
+                                    bool weak, int success, int failure)
+   T __atomic_load_N(void *p, int order)
+   void __atomic_store_N(void *p, T value, int order)
+   bool __atomic_test_and_set_N(void *p, int order)  (on the first byte)
+
+   Every operation is sequentially consistent. */
+
+        .text
+
+        .global __atomic_load_1
+__atomic_load_1:
+        fence   rw, rw
+        lbu     a0, 0(a0)
+        fence   rw, rw
+        ret
+
+        .global __atomic_load_2
+__atomic_load_2:
+        fence   rw, rw
+        lhu     a0, 0(a0)
+        fence   rw, rw
+        ret
+
+        .global __atomic_load_4
+__atomic_load_4:
+        fence   rw, rw
+        lw      a0, 0(a0)
+        fence   rw, rw
+        ret
+
+        .global __atomic_store_1
+__atomic_store_1:
+        fence   rw, w
+        sb      a1, 0(a0)
+        fence   rw, rw
+        ret
+
+        .global __atomic_store_2
+__atomic_store_2:
+        fence   rw, w
+        sh      a1, 0(a0)
+        fence   rw, rw
+        ret
+
+        .global __atomic_store_4
+__atomic_store_4:
+        fence   rw, w
+        sw      a1, 0(a0)
+        fence   rw, rw
+        ret
+
+        .global __atomic_compare_exchange_4
+__atomic_compare_exchange_4:
+        lw      a4, 0(a1)
+1:      lr.w.aqrl a5, (a0)
+        bne     a5, a4, 2f
+        sc.w.aqrl a6, a2, (a0)
+        bnez    a6, 1b
+        li      a0, 1
+        ret
+2:      sw      a5, 0(a1)
+        li      a0, 0
+        ret
+
+/* 1 and 2 bytes: LR/SC on the aligned word that holds them.
+   a0 word address, t3 shift, t4 mask, a4 expected, a2 desired (shifted),
+   t5 0 for one byte, 1 for two */
+        .global __atomic_compare_exchange_1
+__atomic_compare_exchange_1:
+        lbu     a4, 0(a1)
+        andi    a2, a2, 0xff
+        li      t4, 0xff
+        li      t5, 0
+        j       3f
+        .global __atomic_compare_exchange_2
+__atomic_compare_exchange_2:
+        lhu     a4, 0(a1)
+        lui     t4, 0x10
+        addi    t4, t4, -1
+        and     a2, a2, t4
+        li      t5, 1
+3:      andi    t3, a0, 3
+        slli    t3, t3, 3
+        andi    a0, a0, -4
+        sll     t4, t4, t3
+        sll     a4, a4, t3
+        sll     a2, a2, t3
+1:      lr.w.aqrl a5, (a0)
+        and     a6, a5, t4
+        bne     a6, a4, 2f
+        xor     a6, a5, a6
+        or      a6, a6, a2
+        sc.w.aqrl a7, a6, (a0)
+        bnez    a7, 1b
+        li      a0, 1
+        ret
+2:      srl     a6, a6, t3
+        bnez    t5, 4f          /* two bytes */
+        sb      a6, 0(a1)
+        li      a0, 0
+        ret
+4:      sh      a6, 0(a1)
+        li      a0, 0
+        ret
+
+/* set the byte at a0 to 1, return whether it was set */
+        .global __atomic_test_and_set_1
+        .global __atomic_test_and_set_2
+        .global __atomic_test_and_set_4
+        .global __atomic_test_and_set_8
+        .global atomic_flag_test_and_set
+        .global atomic_flag_test_and_set_explicit
+__atomic_test_and_set_1:
+__atomic_test_and_set_2:
+__atomic_test_and_set_4:
+__atomic_test_and_set_8:
+atomic_flag_test_and_set:
+atomic_flag_test_and_set_explicit:
+        andi    t3, a0, 3
+        slli    t3, t3, 3
+        andi    a0, a0, -4
+        li      a1, 1
+        sll     a1, a1, t3
+        amoor.w.aqrl a2, a1, (a0)
+        srl     a2, a2, t3
+        andi    a0, a2, 0xff
+        snez    a0, a0
+        ret
+
+        .global atomic_flag_clear
+        .global atomic_flag_clear_explicit
+atomic_flag_clear:
+atomic_flag_clear_explicit:
+        fence   rw, w
+        sb      zero, 0(a0)
+        fence   rw, rw
+        ret
+
+        .global atomic_thread_fence
+atomic_thread_fence:
+        fence   rw, rw
+        ret
+
+        .global atomic_signal_fence
+atomic_signal_fence:
+        ret
