# BusyBox for the disk guest, on top of Buildroot's default busybox.config.
# Static: every applet exec (init scripts, shells, /bin/true) skips musl's
# dynamic loader and its relocation and GOT pages. The other programs still
# link against libc.so.
CONFIG_STATIC=y
# taskset: run a program on a chosen CPU (the two-CPU kernel, pico-shell.sh -c 2)
CONFIG_TASKSET=y
