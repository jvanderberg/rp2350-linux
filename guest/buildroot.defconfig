# rv32ima, no FPU, no compressed: matches the emulator and Hazard3 (minus C)
BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_32=y
BR2_RISCV_USE_MMU=y
BR2_RISCV_ABI_ILP32=y
# small static userland
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_6_12=y
BR2_STATIC_LIBS=y
BR2_OPTIMIZE_S=y
BR2_STRIP_strip=y
BR2_TARGET_GENERIC_HOSTNAME="rp2350"
BR2_TARGET_GENERIC_ISSUE="rvemu guest"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_ROOTFS_CPIO=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_ROOTFS_POST_BUILD_SCRIPT="/guest/post-build.sh"
