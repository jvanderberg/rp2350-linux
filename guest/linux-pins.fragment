# PINS=1 (run-build.sh): the RP2350's pins (rvemu-rs/rvcore/src/periph.rs),
# GPIO, I2C, SPI, PWM and the ADC, on top of linux-disk.fragment
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
# CONFIG_GPIO_CDEV_V1 is not set
CONFIG_RVEMU_GPIO=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_RVEMU_I2C=y
# CONFIG_I2C_HELPER_AUTO is not set
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_RVEMU_SPI=y
CONFIG_SPI_SPIDEV=y
CONFIG_PWM=y
CONFIG_RVEMU_PWM=y
CONFIG_IIO=y
# CONFIG_IIO_BUFFER is not set
# CONFIG_IIO_TRIGGER is not set
CONFIG_RVEMU_ADC=y
