# SPDX-License-Identifier: GPL-2.0
# Devices of the rvemu machine: the RP2350's pins as the emulator presents
# them (rvemu-rs/rvcore/src/periph.rs), and the firmware's native engine
# (rvemu-rs/rvaccel). guest/build.sh copies this directory into the kernel
# tree.

config RVEMU_GPIO
	bool "rvemu GPIO controller"
	depends on GPIOLIB && OF
	select GPIOLIB_IRQCHIP
	help
	  The rvemu machine's GPIO controller: the RP2350's pads, with pulls
	  and edge interrupts.

config RVEMU_PWM
	bool "rvemu PWM controller"
	depends on PWM && OF
	help
	  The rvemu machine's PWM controller: one channel per GPIO, on the
	  RP2350's PWM slices.

config RVEMU_ADC
	bool "rvemu ADC"
	depends on IIO && OF
	help
	  The rvemu machine's ADC: the RP2350B's ADC inputs GP40-GP47 and its
	  temperature sensor.

config RVEMU_I2C
	bool "rvemu I2C controllers"
	depends on I2C && OF
	help
	  The rvemu machine's I2C controllers: the RP2350's I2C0 and I2C1,
	  driven synchronously by the emulator.

config RVEMU_SPI
	bool "rvemu SPI controller"
	depends on SPI_MASTER && OF
	help
	  The rvemu machine's SPI controllers, one per RP2350 SPI block
	  (SPI1 carries the SD card), driven synchronously by the emulator.

config RVEMU_CRYPTO
	bool "rvemu native crypto engine"
	depends on RISCV_SBI
	help
	  /dev/rvemu-crypto: the rvemu machine's native buffer engine (SBI
	  extension 0x0a000001): X25519, Ed25519, ChaCha20-Poly1305,
	  sntrup761 and LZ4, run by the firmware in time slices. The device
	  appears only when the firmware has the engine.

config RVEMU_SSH
	bool "rvemu SSH packet engine"
	depends on RVEMU_CRYPTO
	help
	  /dev/rvemu-ssh: chacha20-poly1305@openssh.com packets sealed and
	  opened by the native engine, for Dropbear.

config RVEMU_BENCH
	bool "rvemu benchmark points"
	depends on RISCV_SBI
	help
	  /dev/rvemu-bench: points at which the firmware records its cycle
	  counters (SBI extension 0x0a000002), and the report it prints on
	  its console.
